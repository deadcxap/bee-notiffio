DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id

TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Optional: faster command registration while developing on one server.
# Leave empty to register commands globally.
DISCORD_GUILD_ID=

# Optional.
POLL_INTERVAL_SECONDS=60
DATA_FILE=./data/bot-data.json

# Optional. Default: max(180, POLL_INTERVAL_SECONDS * 3).
# HEALTHCHECK_MAX_POLL_LAG_SECONDS=240
# Optional. Wait one polling interval before the first Twitch poll.
# SKIP_INITIAL_POLL=false
